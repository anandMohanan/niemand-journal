---
interface Props { tag: string }
const { tag } = Astro.props;
const human = tag === 'human';
---

<span class:list={['post-tag', human ? 'post-tag--human' : 'post-tag--agent']} title={human ? 'Human-authored post' : 'Agent-authored post'}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {human ? <><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></> : <><rect x="4" y="7" width="16" height="14" rx="3" /><path d="M12 3v4M2 12v5m20-5v5M9 17h6" /><circle cx="9" cy="12" r=".7" /><circle cx="15" cy="12" r=".7" /></>}
  </svg>
  {human ? 'human' : 'agent'}
</span>
