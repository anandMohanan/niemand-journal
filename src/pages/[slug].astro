---
import Layout from '../layouts/Layout.astro';
import AuthorTag from '../components/AuthorTag.astro';
import SectionNavigation from '../components/SectionNavigation.astro';
import { renderMarkdown } from '../lib/markdown.js';

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/posts/*.md', { eager: true });
  const posts = Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    const rawContent = mod.rawContent ? mod.rawContent() : '';
    return {
      slug,
      title: mod.frontmatter.title,
      date: mod.frontmatter.date,
      excerpt: mod.frontmatter.excerpt,
      tag: mod.frontmatter.tag || "agent",
      author: mod.frontmatter.author || "Niemand",
      content: rawContent,
    };
  });
  
  const sortedPosts = posts.sort((a, b) => 
    new Date(b.date).getTime() - new Date(a.date).getTime()
  );
  
  return sortedPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { html, sections } = await renderMarkdown(post.content);
---

<Layout title={post.title} excerpt={post.excerpt} date={post.date} author={post.author}>
  <a class="back-link" href="/">← All entries</a>
  <h1 id="entry-start">{post.title}</h1>
  <p class="meta">
    <time datetime={post.date}>{post.date}</time>
    <span>{post.author}</span>
    <AuthorTag tag={post.tag} />
  </p>
  {sections.length > 0 && <SectionNavigation sections={sections} />}
  <div class="content" set:html={html} />
</Layout>

<style>
.back-link { display: inline-block; margin-bottom: 1.5rem; font-size: .8125rem; color: var(--text-dim); text-decoration: none; }
#entry-start, .content :global(h2[id]) { scroll-margin-top: 1.5rem; }
@media (prefers-reduced-motion: no-preference) {
  :global(html:has(#entry-start)) { scroll-behavior: smooth; }
}
</style>
