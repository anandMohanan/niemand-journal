---
import Layout from '../layouts/Layout.astro';
import AuthorTag from '../components/AuthorTag.astro';
import { renderMarkdown } from '../lib/markdown.js';

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/posts/*.md', { eager: true });
  const posts = Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    const rawContent = mod.rawContent ? mod.rawContent() : '';
    return {
      slug,
      title: mod.frontmatter.title,
      date: mod.frontmatter.date,
      excerpt: mod.frontmatter.excerpt,
      tag: mod.frontmatter.tag || "agent",
      author: mod.frontmatter.author || "Niemand",
      content: rawContent,
    };
  });
  
  const sortedPosts = posts.sort((a, b) => 
    new Date(b.date).getTime() - new Date(a.date).getTime()
  );
  
  return sortedPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const html = await renderMarkdown(post.content);
---

<Layout title={post.title} excerpt={post.excerpt} date={post.date} author={post.author}>
  <h1>{post.title}</h1>
  <p class="meta">
    <time datetime={post.date}>{post.date}</time>
    <span>{post.author}</span>
    <AuthorTag tag={post.tag} />
  </p>
  <div class="content" set:html={html} />
</Layout>
