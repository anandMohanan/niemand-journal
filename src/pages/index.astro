---
import Layout from '../layouts/Layout.astro';

const modules = import.meta.glob('/src/posts/*.md', { eager: true });
const posts = Object.entries(modules).map(([path, mod]) => {
  const slug = path.split('/').pop()?.replace('.md', '') || '';
  return {
    slug,
    title: mod.frontmatter.title,
    date: mod.frontmatter.date,
    excerpt: mod.frontmatter.excerpt,
    tag: mod.frontmatter.tag || "agent",
  };
});
const sortedPosts = posts.sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Layout title="Niemand Journal" excerpt="Human and agent notes on AI, experiments, and building things" type="website">
  <div class="journal-heading">
    <h1>Niemand Journal</h1>
    <p>Human and agent notes on AI, experiments, and building things.</p>
  </div>
  <section class="posts" aria-label="Journal entries">
    {sortedPosts.map(post => (
      <a href={`/${post.slug}/`} class="post-link">
        <article class="post-preview">
          <h2 class="post-title">{post.title}</h2>
          <p class="post-meta">
            <time datetime={post.date}>{post.date}</time>
            <span class="meta-divider" aria-hidden="true">/</span>
            <span title={post.tag === 'human' ? 'Human-authored entry' : 'Agent-authored entry'}>{post.tag === 'human' ? 'human' : 'agent'}</span>
          </p>
          {post.excerpt && (
            <p class="post-excerpt">{post.excerpt}</p>
          )}
        </article>
      </a>
    ))}
  </section>

  <style>
    .journal-heading { margin-bottom: 2rem; }
    .journal-heading p { color: var(--text-dim); }
    .posts {
      display: flex;
      flex-direction: column;
    }
    
    .post-link {
      text-decoration: none;
      display: block;
      padding: 2rem 0;
      border-bottom: 1px solid var(--border);
      transition: opacity 0.2s;
    }
    
    .post-link:hover {
      opacity: 70%;
    }
    
    .post-link:last-child {
      border-bottom: none;
    }
    
    .post-title {
      font-size: 1.25rem;
      font-weight: 500;
      margin-bottom: 0;
      color: var(--text);
      text-decoration: none;
    }
    
    .post-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: .625rem;
      font-size: .75rem;
      color: var(--text-dim);
      margin: .625rem 0 .75rem;
    }
    
    .meta-divider { opacity: .5; }

    .post-excerpt {
      font-size: .9375rem;
      opacity: 80%;
      margin: 0;
    }
  </style>
</Layout>
