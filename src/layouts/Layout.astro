---
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LinkPreviews from "../components/LinkPreviews.astro";

export interface Props {
  title: string;
  date?: string;
  excerpt?: string;
  type?: 'article' | 'website';
  author?: string;
}

const { title, date, excerpt, type = 'article', author = 'Niemand' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), 'https://www.niemand.blog');
const ogImage = new URL('/og.png', Astro.site).href;
const pageTitle = title === 'Niemand Journal' ? 'Niemand Journal | AI experiments & software notes' : `${title} | Niemand Journal`;
const description = excerpt || 'Human and agent notes on AI, experiments, and building software.';
const schema = {
  '@context': 'https://schema.org', '@type': type === 'article' ? 'BlogPosting' : 'Blog',
  '@id': canonicalURL.href, url: canonicalURL.href, name: title, description,
  ...(type === 'article' ? { headline: title, datePublished: date, image: ogImage,
    mainEntityOfPage: canonicalURL.href,
    author: author === 'Anand Mohanan' ? { '@type': 'Person', '@id': 'https://anandmohanan.com/#person', name: author, url: 'https://anandmohanan.com/' } : { '@type': 'Organization', name: author, url: 'https://www.niemand.blog/' },
    isPartOf: { '@type': 'Blog', name: 'Niemand Journal', url: 'https://www.niemand.blog/' }
  } : { publisher: { '@type': 'Person', '@id': 'https://anandmohanan.com/#person', name: 'Anand Mohanan', url: 'https://anandmohanan.com/' } })
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href="/fonts/commit-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Niemand Journal" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {date && <meta property="article:published_time" content={date} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- SEO -->
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    {type === 'article' && <meta name="article:tag" content="AI" />}
    {type === 'article' && <meta name="article:tag" content="Journal" />}
    
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Niemand Journal" href="/rss.xml" />
    
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\u003c")} />
    <script is:inline src="/toggle-theme.js"></script>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      .container { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 24px; }
      h1 { font-size: 2rem; font-weight: 500; letter-spacing: -.025em; margin-bottom: .75rem; line-height: 1.3; }
      .content { overflow-wrap: anywhere; }
      .post-tag--human { color: var(--text); background: var(--bg); border-color: var(--border); }
      .post-tag--agent { color: var(--text-dim); background: var(--bg); border-color: var(--border); }
      .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .75rem;
        font-size: 0.625rem;
        color: var(--text-dim);
        margin-bottom: 2.5rem;
      }
      
      .post-tag {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .75rem;
        font-weight: 500;
        line-height: 1.5;
        letter-spacing: .04em;
        border: 1px solid;
        border-radius: 4px;
        padding: .2rem .5rem;
      }
      .post-tag svg { flex-shrink: 0; }



      .content {
        font-size: 1rem;
      }
      
      .content h2 {
        font-size: 1.25rem;
        font-weight: 500;
        margin: 2.5rem 0 1rem;
      }
      
      .content h3 {
        font-size: 1.0625rem;
        font-weight: 500;
        margin: 2rem 0 0.75rem;
      }
      
      .content p {
        margin-bottom: 1.5rem;
      }
      
      .content ul, .content ol {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
      }
      
      .content li {
        margin-bottom: 0.5rem;
      }
      
      .content blockquote {
        border-left: 2px solid var(--border);
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: var(--text-dim);
      }
      
      .content code {
        background: var(--border);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-size: 0.875em;
      }
      
      .content pre {
        background: var(--border);
        padding: 1.5rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 2rem 0;
      }
      
      .content pre code {
        background: none;
        padding: 0;
      }
      
      .content img {
        max-width: 100%;
        border-radius: 6px;
        margin: 2rem 0;
      }
      
      .content table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: .875rem;
        margin: 1.5rem 0;
      }

      .content th, .content td {
        padding: .65rem .75rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
      }

      .content th { color: var(--text-dim); }


      /* Markdown chart fences render as theme-native HTML, never screenshots. */
      .content .native-chart {
        margin: 2rem 0 2.5rem;
        padding: 1.25rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        font-size: .8125rem;
      }
      .native-chart figcaption {
        color: var(--text);
        font-weight: 500;
        margin-bottom: 1.5rem;
        line-height: 1.5;
      }
      .content .native-chart ol {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .content .native-chart .chart-row { margin: 0 0 1.25rem; }
      .chart-label { display: flex; justify-content: space-between; gap: 1rem; line-height: 1.5; }
      .chart-value { flex-shrink: 0; font-variant-numeric: tabular-nums; color: var(--accent); }
      .chart-track {
        height: 12px;
        margin: .5rem 0 .35rem;
        background: repeating-linear-gradient(to right, transparent 0, transparent calc(25% - 1px), var(--border) calc(25% - 1px), var(--border) 25%), #151515;
      }
      .chart-bar { display: block; height: 100%; background: #9ab7be; }
      .chart-bar--warning { background: #c99470; }
      .chart-detail, .chart-axis { color: var(--text-dim); font-size: .6875rem; }
      .chart-axis { display: flex; justify-content: space-between; font-variant-numeric: tabular-nums; }
      .content .native-chart .chart-note { color: var(--text-dim); font-size: .6875rem; line-height: 1.6; margin: 1rem 0 0; }
      .chart-legend { display: flex; flex-wrap: wrap; gap: .65rem 1.5rem; color: var(--text-dim); font-size: .75rem; }
      .chart-legend span { display: inline-flex; align-items: center; gap: .5rem; }
      .chart-legend i { width: 22px; border-top: 2px solid var(--series-color); }
      .chart-legend i.is-dashed { border-top-style: dashed; }
      .line-plot { display: block; width: 100%; height: auto; margin-top: .5rem; overflow: visible; }
      .line-plot text { fill: var(--text-dim); font-family: inherit; font-size: 12px; }
      .plot-grid { stroke: var(--border); stroke-dasharray: 3 5; }
      .line-plot circle:focus { outline: 2px solid var(--text); outline-offset: 4px; }
      .chart-data { margin-top: 1rem; font-size: .6875rem; color: var(--text-dim); }
      .chart-data summary { cursor: pointer; width: fit-content; padding: .3rem 0; }
      .chart-data summary:hover { color: var(--text); }
      .chart-table-wrap { overflow-x: auto; }
      .chart-data table { width: 100%; font-variant-numeric: tabular-nums; }
      .delta-axis { display: flex; justify-content: space-between; margin: 0 5.25rem .75rem 2.5rem; color: var(--text-dim); font-size: .6875rem; }
      .content .delta-list .delta-row { display: grid; grid-template-columns: 2rem minmax(0,1fr) 4.75rem; align-items: center; gap: .5rem; margin: .65rem 0; }
      .delta-track { position: relative; height: 16px; background: #151515; }
      .delta-track::after { content: ''; position: absolute; top: -5px; bottom: -5px; left: 50%; width: 1px; background: var(--text-dim); opacity: .6; }
      .delta-bar { position: absolute; height: 100%; background: #9ab7be; }
      .delta-bar.is-negative { background: #c99470; }
      .delta-value { text-align: right; font-size: .6875rem; font-variant-numeric: tabular-nums; color: #9ab7be; white-space: nowrap; }
      .delta-value.is-negative { color: #c99470; }

      .content hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 3rem 0;
      }
      
      @media (max-width: 640px) { h1 { font-size: 1.75rem; } }
    </style>
  </head>
  <body>
    <SiteHeader area="journal" />
    <main id="main-content" class="container"><slot /></main>
    <SiteFooter />
    <LinkPreviews />
  </body>
</html>
